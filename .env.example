# AI JobBot Environment Variables

# Flask
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Session Secret (use the available SESSION_SECRET from Replit)
SESSION_SECRET=your-session-secret

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:latest

# Anthropic API (for consultant)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-webhook-secret

# Subscription Pricing
FREE_TRIAL_DAYS=30
BASIC_PLAN_PRICE=5
PRO_PLAN_PRICE=15

# Credit Costs
CREDIT_COST_PER_PARSE=0
CREDIT_COST_PER_LETTER=1
CREDIT_COST_PER_APPLY=1

# Encryption
ENCRYPTION_KEY=generate-with-fernet-key

# News API (optional)
NEWS_API_KEY=your-news-api-key

# Application
PORT=5000
